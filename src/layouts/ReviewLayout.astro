---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import StickyTOC from "../components/StickyTOC.astro";
import RatingBadge from "../components/RatingBadge.astro";
import RatingStars from "../components/RatingStars.astro";
import ProsCons from "../components/ProsCons.astro";
import AffCard from "../components/AffCard.astro";
import SpecTable from "../components/SpecTable.astro";
import ScoreBreakdown from "../components/ScoreBreakdown.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { formatCategory, formatPrice, formatDate, getScoreColor } from "../utils/format";

/**
 * ReviewLayout — single review page.
 * Left: sticky TOC. Center: content (8/12). Right: sticky sidebar (4/12).
 */
interface Props {
  title: string;
  description: string;
  category: string;
  brand: string;
  model: string;
  rating: number;
  pros: string[];
  cons: string[];
  verdict: string;
  verdictLabel: "buy" | "wait" | "skip";
  price?: number;
  priceCurrency?: string;
  amazonUrl?: string;
  amazonAsin?: string;
  subscores?: {
    performance: number;
    value: number;
    design: number;
    features: number;
    battery?: number;
  };
  publishedAt: Date | string;
  updatedAt?: Date | string;
  testedBy?: string;
  testMethodology?: string;
  canonical?: string;
  schema?: object;
  tocItems?: { id: string; text: string }[];
  specs?: { label: string; value: string }[];
  relatedReviews?: {
    title: string;
    description: string;
    category: string;
    rating: number;
    price?: number;
    priceCurrency?: string;
    pros?: string[];
    cons?: string[];
    href: string;
    verdictLabel?: "buy" | "wait" | "skip";
  }[];
}

const {
  title,
  description,
  category,
  brand,
  model,
  rating,
  pros,
  cons,
  verdict,
  verdictLabel,
  price,
  priceCurrency = "USD",
  amazonUrl,
  amazonAsin,
  subscores,
  publishedAt,
  updatedAt,
  testedBy = "Alex Chen",
  testMethodology = "v1.0",
  canonical,
  schema,
  tocItems = [],
  specs = [],
  relatedReviews = [],
} = Astro.props;

const canonicalUrl = canonical ?? `https://geektechreview.com/reviews/${category}/${model}/`;
const categoryLabel = formatCategory(category);
const priceStr = formatPrice(price, priceCurrency);
const color = getScoreColor(rating);

const verdictMeta: Record<string, { label: string; color: string }> = {
  buy: { label: "Buy", color: "var(--color-success)" },
  wait: { label: "Wait", color: "var(--color-warning)" },
  skip: { label: "Skip", color: "var(--color-danger)" },
};
const vm = verdictMeta[verdictLabel] ?? verdictMeta.buy;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Reviews", href: "/reviews/" },
  { name: categoryLabel, href: `/reviews/${category}/` },
  { name: title, href: canonicalUrl },
];
---

<BaseLayout title={`${title} — Review`} description={description} canonical={canonicalUrl} schema={schema}>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <div class="grid gap-8 lg:grid-cols-12">
      {/* Left: sticky TOC */}
      <div class="hidden lg:block lg:col-span-2">
        <StickyTOC items={tocItems} />
      </div>

      {/* Center: main content */}
      <article class="lg:col-span-7">
        <header class="mb-6">
          <div class="mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)]">
            <a href={`/reviews/${category}/`} class="hover:text-[var(--color-primary)]">{categoryLabel}</a>
            <span>·</span>
            <span>{brand}</span>
          </div>
          <h1 class="mb-3">{title}</h1>
          <p class="text-lg text-[var(--color-muted)]">{description}</p>

          {/* Mobile rating */}
          <div class="mt-5 flex items-center gap-4 lg:hidden">
            <RatingBadge score={rating} size="sm" />
            <div>
              <RatingStars score={rating} />
              <div class="mt-1 text-xs text-[var(--color-muted)]">
                By {testedBy} · {formatDate(publishedAt)}
              </div>
            </div>
          </div>
        </header>

        <div class="prose" data-prose>
          <slot />
        </div>

        {/* Verdict callout */}
        <div class="mt-8 card-surface p-6" style={`border-left:4px solid ${color}`}>
          <div class="mb-2 flex items-center gap-2">
            <span class="rounded-full px-2.5 py-0.5 text-xs font-bold uppercase tracking-wide text-white" style={`background-color:${vm.color}`}>{vm.label}</span>
            <span class="text-xs text-[var(--color-muted)]">Our verdict</span>
          </div>
          <p class="text-base leading-relaxed text-[var(--color-text)]">{verdict}</p>
        </div>
      </article>

      {/* Right: sticky sidebar */}
      <aside class="lg:col-span-3">
        <div class="sticky top-20 space-y-4">
          <div class="card-surface p-5 text-center">
            <RatingBadge score={rating} size="lg" />
            <div class="mt-2 flex justify-center">
              <RatingStars score={rating} size={16} />
            </div>
            <div class="mt-3 text-xs text-[var(--color-muted)]">
              By {testedBy} · {formatDate(publishedAt)}
            </div>
            {updatedAt && (
              <div class="text-[11px] text-[var(--color-muted)]">Updated {formatDate(updatedAt)}</div>
            )}
          </div>

          <AffCard
            amazonUrl={amazonUrl}
            amazonAsin={amazonAsin}
            price={price}
            priceCurrency={priceCurrency}
            priceLabel={priceStr}
          />

          <div class="card-surface p-4">
            <div class="flex items-center justify-between text-sm">
              <span class="text-[var(--color-muted)]">Verdict</span>
              <span class="font-bold" style={`color:${vm.color}`}>{vm.label}</span>
            </div>
          </div>

          <ProsCons pros={pros} cons={cons} />

          {subscores && <ScoreBreakdown subscores={subscores} />}

          <SpecTable brand={brand} model={model} price={price} priceCurrency={priceCurrency} specs={specs} />

          <div class="card-surface p-4 text-xs text-[var(--color-muted)]">
            <div class="font-semibold text-[var(--color-text)]">Tested methodology</div>
            <div class="mt-1">Methodology {testMethodology} · Independent purchase.</div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
