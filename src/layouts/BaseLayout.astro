---
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
const { title, description, canonical, schema } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark antialiased overflow-x-hidden selection:bg-primary-500/30">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Space Grotesk', sans-serif; }</style>
    <link rel="canonical" href={canonical} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

  </head>
  <body class="relative min-h-screen bg-dark">
    <!-- Ambient Background Blobs -->
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
      <div class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-primary-500/20 rounded-full mix-blend-screen filter blur-[120px] animate-blob"></div>
      <div class="absolute top-[20%] right-[-10%] w-[400px] h-[400px] bg-purple-500/10 rounded-full mix-blend-screen filter blur-[100px] animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-[-20%] left-[20%] w-[600px] h-[600px] bg-blue-500/10 rounded-full mix-blend-screen filter blur-[120px] animate-blob animation-delay-4000"></div>
    </div>

    <header class="fixed top-0 w-full z-50 bg-dark/60 backdrop-blur-xl border-b border-white/5 supports-[backdrop-filter]:bg-dark/40">
      <div class="container mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-extrabold tracking-tight flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-gradient-to-tr from-primary-500 to-primary-600 shadow-lg shadow-primary-500/20"></div>
          {title.split('—')[0].trim()}
        </a>
        <nav class="hidden md:flex gap-8 text-sm font-medium text-slate-400">
          <a href="/en/categories/" class="hover:text-white transition-colors">Categories</a>
          <a href="/en/latest/" class="hover:text-white transition-colors">Latest</a>
        </nav>
      </div>
    </header>
    
    <main class="pt-24 pb-16">
      <slot />
    </main>
    
    <footer class="border-t border-white/5 py-12 text-center text-sm text-slate-600 bg-black/20">
      <p>&copy; {new Date().getFullYear()} {title.split('—')[0].trim()}. All rights reserved.</p>
    </footer>
      <CookieBanner />
  
<!-- Email Capture -->
<div id="email-capture" class="fixed bottom-0 left-0 w-full bg-primary-500 text-white p-4 z-[100] transform transition-transform translate-y-full flex justify-center items-center gap-6 shadow-[0_-10px_40px_rgba(0,0,0,0.5)] border-t border-white/20">
  <div class="font-bold text-lg hidden md:block">Join 50,000+ tech leaders getting weekly deep-dives & lifetime deals.</div>
  <form class="flex gap-2" onsubmit="event.preventDefault(); alert('Subscribed to the newsletter!'); document.getElementById('email-capture').style.display='none';">
    <input type="email" placeholder="Your best email address" class="px-5 py-2.5 rounded-lg text-black outline-none w-72 focus:ring-4 ring-black/20 font-medium" required>
    <button type="submit" class="bg-[#000000] text-white font-bold px-8 py-2.5 rounded-lg hover:bg-[#222222] transition-colors shadow-lg">Subscribe</button>
  </form>
  <button type="button" onclick="document.getElementById('email-capture').style.display='none'" class="absolute right-6 top-1/2 -translate-y-1/2 text-white/70 hover:text-white font-bold text-xl">✕</button>
</div>
<script>
  setTimeout(() => {
    document.getElementById('email-capture').classList.remove('translate-y-full');
  }, 4000); // pop up after 4 seconds
</script>
\n  </body>
</html>

