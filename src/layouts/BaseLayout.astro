---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

/**
 * BaseLayout — dark mode by default.
 * Removed: blob backgrounds, email capture popup, CookieBanner.
 * Added: font preconnect/preload, theme toggle, proper header/footer.
 */
interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: object;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  schema,
  noindex = false,
  ogImage = "/og-image.png",
} = Astro.props;
const year = new Date().getFullYear();
const ogImageUrl = new URL(ogImage, Astro.site).href;

const nav = [
  { label: "Reviews", href: "/reviews/" },
  { label: "Best Of", href: "/best/laptops/" },
  { label: "Compare", href: "/compare/" },
  { label: "Deals", href: "/deals/" },
  { label: "Guides", href: "/guides/" },
  { label: "About", href: "/about/" },
];

const footerCategories = [
  { label: "Laptops", href: "/reviews/laptops/" },
  { label: "Phones", href: "/reviews/phones/" },
  { label: "Audio", href: "/reviews/audio/" },
  { label: "Gaming", href: "/reviews/gaming/" },
  { label: "PC Components", href: "/reviews/pc-components/" },
  { label: "Smart Home", href: "/reviews/smart-home/" },
  { label: "AI Devices", href: "/reviews/ai-devices/" },
  { label: "Creator Gear", href: "/reviews/creator-gear/" },
];
---

<!doctype html>
<html lang="en" class="dark antialiased selection:bg-[var(--color-primary)]/30">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    {/* Fonts: preconnect + preload + non-blocking stylesheet */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="GeekTechReview" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Theme init (runs before paint to avoid flash) */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light") document.documentElement.classList.add("light");
          else document.documentElement.classList.remove("light");
        } catch (e) {}
      })();
    </script>

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)]">
    <header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur-xl">
      <div class="container-page flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 text-lg font-bold tracking-tight">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-[var(--color-primary)] to-[var(--color-accent)] text-xs font-black text-white shadow-lg shadow-[var(--color-primary)]/20">
            G
          </span>
          <span>GeekTechReview</span>
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium text-[var(--color-muted)] md:flex">
          {nav.map((n) => (
            <a href={n.href} class="transition-colors hover:text-[var(--color-text)]">{n.label}</a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-[var(--color-border)] bg-[var(--color-surface)]/40">
      <div class="container-page py-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          {/* Brand */}
          <div class="sm:col-span-2 lg:col-span-1">
            <a href="/" class="flex items-center gap-2.5 text-lg font-bold">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-tr from-[var(--color-primary)] to-[var(--color-accent)] text-xs font-black text-white">
                G
              </span>
              <span>GeekTechReview</span>
            </a>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-[var(--color-muted)]">
              In-depth, lab-tested reviews of AI-era hardware — laptops, phones, audio, gaming, and more. No fluff, just verdicts.
            </p>
          </div>

          {/* Categories */}
          <div>
            <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-[var(--color-muted)]">Categories</h3>
            <ul class="space-y-2 text-sm">
              {footerCategories.map((c) => (
                <li><a href={c.href} class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">{c.label}</a></li>
              ))}
            </ul>
          </div>

          {/* Resources */}
          <div>
            <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-[var(--color-muted)]">Resources</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/best/laptops/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Best Of guides</a></li>
              <li><a href="/compare/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Product comparisons</a></li>
              <li><a href="/deals/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Today's deals</a></li>
              <li><a href="/guides/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Buying guides</a></li>
            </ul>
          </div>

          {/* Company */}
          <div>
            <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-[var(--color-muted)]">Company</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/about/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">About us</a></li>
              <li><a href="/how-we-test/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">How we test</a></li>
              <li><a href="/editorial-policy/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Editorial policy</a></li>
              <li><a href="/affiliate-disclosure/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Affiliate disclosure</a></li>
              <li><a href="/contact/" class="text-[var(--color-muted)] hover:text-[var(--color-primary)]">Contact</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 border-t border-[var(--color-border)] pt-6">
          <p class="text-xs leading-relaxed text-[var(--color-muted)]">
            <strong class="text-[var(--color-text)]">Affiliate disclosure:</strong> As an Amazon Associate, GeekTechReview earns from qualifying purchases. Links to Amazon are sponsored and may earn us a commission at no extra cost to you. Prices and availability are accurate as of the time shown and are subject to change. See our <a href="/affiliate-disclosure/" class="underline hover:text-[var(--color-primary)]">affiliate disclosure</a> for details.
          </p>
          <p class="mt-3 text-xs text-[var(--color-muted)]">
            &copy; {year} GeekTechReview. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
