---
import { formatPrice } from "../utils/format";

/**
 * SpecTable — product spec table.
 */
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  brand: string;
  model: string;
  price?: number;
  priceCurrency?: string;
  specs?: SpecRow[];
}

const { brand, model, price, priceCurrency = "USD", specs = [] } = Astro.props;
const priceStr = formatPrice(price, priceCurrency);
const rows: SpecRow[] = [
  { label: "Brand", value: brand },
  { label: "Model", value: model },
  ...(price !== undefined ? [{ label: "Price", value: priceStr ?? "—" }] : []),
  ...specs,
];
---

<div class="card-surface overflow-hidden">
  <h3 class="border-b border-[var(--color-border)] px-4 py-3 text-sm font-bold uppercase tracking-wide text-[var(--color-muted)]">
    Specs
  </h3>
  <table class="w-full text-sm">
    <tbody>
      {rows.map((row, i) => (
        <tr class={i % 2 === 0 ? "bg-[var(--color-surface-2)]/40" : ""}>
          <th scope="row" class="w-1/3 px-4 py-2.5 text-left font-medium text-[var(--color-muted)] align-top">
            {row.label}
          </th>
          <td class="px-4 py-2.5 text-[var(--color-text)] font-mono text-[0.85rem]">{row.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
