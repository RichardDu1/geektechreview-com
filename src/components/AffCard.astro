---
import AffButton from "./AffButton.astro";
import { formatAmazonUrl, formatPrice } from "../utils/aff";

/**
 * AffCard — product price card. Multi-retailer ready, Amazon-only for now.
 */
interface Props {
  amazonUrl?: string;
  amazonAsin?: string;
  price?: number;
  priceCurrency?: string;
  priceLabel?: string;
  title?: string;
}

const {
  amazonUrl,
  amazonAsin,
  price,
  priceCurrency = "USD",
  priceLabel,
  title,
} = Astro.props;

const url = formatAmazonUrl(amazonUrl ?? amazonAsin);
const displayPrice = priceLabel ?? formatPrice(price, priceCurrency);
---

<aside class="card-surface p-5">
  {title && (
    <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-[var(--color-muted)]">
      Best Price
    </h3>
  )}

  <div class="mb-4 flex items-baseline gap-2">
    {displayPrice ? (
      <span class="text-3xl font-bold tabular-nums text-[var(--color-text)]">{displayPrice}</span>
    ) : (
      <span class="text-sm text-[var(--color-muted)]">Price unavailable</span>
    )}
    {priceCurrency && displayPrice && (
      <span class="text-xs text-[var(--color-muted)]">{priceCurrency}</span>
    )}
  </div>

  <div class="mb-4 flex items-center gap-2 text-sm">
    <span class="inline-flex items-center gap-1.5 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-2)] px-2.5 py-1 font-medium">
      <span class="font-bold">Amazon</span>
    </span>
    {url && (
      <a href={url} rel="sponsored nofollow" target="_blank" class="text-xs text-[var(--color-primary)] underline-offset-2 hover:underline">
        Check latest price
      </a>
    )}
  </div>

  <AffButton href={url} price={displayPrice} />
  <p class="mt-3 text-center text-[11px] leading-relaxed text-[var(--color-muted)]">
    Price updated daily. We may earn a commission from qualifying purchases.
  </p>
</aside>
