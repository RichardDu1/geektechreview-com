---
/**
 * RatingStars — star display with half-star support (SVG).
 * score is 0-10; converted to a 0-5 star rating.
 */
interface Props {
  score: number;
  size?: number;
}

const { score, size = 20 } = Astro.props;
const stars5 = (score / 10) * 5;

function starFill(i: number): number {
  // i is 1-indexed star position
  if (stars5 >= i) return 1;
  if (stars5 >= i - 0.5) return 0.5;
  return 0;
}
---

<div class="inline-flex items-center gap-0.5" role="img" aria-label={`Rating: ${score} out of 10`}>
  {[1, 2, 3, 4, 5].map((i) => {
    const fill = starFill(i);
    const id = `grad-${Math.round(score * 10)}-${i}`;
    return (
      <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
        <defs>
          <linearGradient id={id} x1="0" x2="1" y1="0" y2="0">
            <stop offset={`${fill * 100}%`} stop="var(--color-warning)" />
            <stop offset={`${fill * 100}%`} stop="var(--color-border)" />
          </linearGradient>
        </defs>
        <path
          d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
          fill={`url(#${id})`}
          stroke="var(--color-warning)"
          stroke-width="1"
          stroke-linejoin="round"
        />
      </svg>
    );
  })}
</div>
