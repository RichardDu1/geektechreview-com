---
/**
 * Breadcrumb navigation with BreadcrumbList JSON-LD schema.
 */
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    item: item.href,
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[var(--color-muted)]">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-[var(--color-border)]">/</span>}
        {i < items.length - 1 ? (
          <a href={item.href} class="hover:text-[var(--color-primary)] hover:underline">{item.name}</a>
        ) : (
          <span class="font-medium text-[var(--color-text)]" aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
