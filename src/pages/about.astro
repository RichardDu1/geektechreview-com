---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { ShieldCheck, Award, Cpu, UserCheck } from "@lucide/astro";

const canonical = "https://geektechreview.com/about/";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "About Us", href: canonical },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "GeekTechReview",
      url: "https://geektechreview.com",
      description: "Lab-tested tech hardware reviews focusing on AI-era devices.",
    },
    {
      "@type": "Person",
      name: "Alex Chen",
      jobTitle: "Lead Hardware Reviewer & Founder",
      worksFor: { "@type": "Organization", name: "GeekTechReview" },
      description: "Hardware engineer and tech analyst specializing in laptop thermals, NPU benchmarks, and desktop components.",
    },
  ],
};
---

<BaseLayout
  title="About GeekTechReview — Lab-Tested AI Hardware Reviews"
  description="Learn about GeekTechReview's mission, lab testing methodology, editorial independence, and lead reviewer Alex Chen."
  canonical={canonical}
  schema={schema}
>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <header class="mb-12 max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]/10 px-3.5 py-1.5 text-xs font-semibold text-[var(--color-primary)]">
        <ShieldCheck class="h-4 w-4" />
        <span>Our Mission & E-E-A-T Commitment</span>
      </div>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        About GeekTechReview
      </h1>
      <p class="mt-4 text-xl text-[var(--color-muted)] leading-relaxed">
        We test AI-era hardware with laboratory precision. No sponsored ratings, no copy-paste spec sheets, just brutally honest verdicts.
      </p>
    </header>

    <!-- Values Grid -->
    <section class="mb-16">
      <h2 class="sr-only">Our Core Values</h2>
      <div class="grid gap-6 sm:grid-cols-3">
      <div class="card-surface p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
          <Award class="h-5 w-5" />
        </div>
        <h3 class="mt-4 font-display text-lg font-bold">100% Independent</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
          We purchase our test units independently or accept review units strictly without editorial influence or approval rights from manufacturers.
        </p>
      </div>

      <div class="card-surface p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
          <Cpu class="h-5 w-5" />
        </div>
        <h3 class="mt-4 font-display text-lg font-bold">AI-Era Focus</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
          From Copilot+ NPUs to local LLM inference setups, we benchmark real-world AI performance alongside traditional thermal and battery metrics.
        </p>
      </div>

      <div class="card-surface p-6">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
          <UserCheck class="h-5 w-5" />
        </div>
        <h3 class="mt-4 font-display text-lg font-bold">Expert Lead Reviewer</h3>
        <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
          Every review is conducted by experienced hardware engineers with years of hands-on benchmarking experience.
        </p>
      </div>
    </section>

    <!-- Editorial Team -->
    <section class="mb-16">
      <h2 class="mb-8 font-display text-3xl font-bold">Editorial Lead</h2>
      <div class="card-surface flex flex-col gap-6 p-8 sm:flex-row sm:items-center">
        <div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-primary)] text-3xl font-black text-white shadow-xl shadow-[var(--color-primary)]/20">
          AC
        </div>
        <div>
          <div class="flex items-center gap-3">
            <h3 class="font-display text-2xl font-bold">Alex Chen</h3>
            <span class="rounded-full bg-[var(--color-surface-2)] px-3 py-0.5 text-xs font-semibold text-[var(--color-muted)]">Lead Hardware Analyst</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-muted)]">
            Alex Chen has spent over a decade benchmarking PC components, laptops, and mobile hardware. With a background in electrical engineering and computer architecture, Alex specializes in thermal dynamics, display colorimetry, and local AI model performance testing.
          </p>
          <div class="mt-4 flex gap-4 text-xs font-semibold text-[var(--color-primary)]">
            <a href="/how-we-test/" class="hover:underline">View Testing Methodology →</a>
            <a href="/editorial-policy/" class="hover:underline">Editorial Guidelines →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Testing Philosophy -->
    <section class="max-w-3xl border-t border-[var(--color-border)] pt-12">
      <h2 class="font-display text-2xl font-bold">Our Testing Philosophy</h2>
      <div class="mt-4 space-y-4 text-sm leading-relaxed text-[var(--color-muted)]">
        <p>
          Modern hardware reviews often focus heavily on synthetic scores that don't reflect daily use. At GeekTechReview, we combine industry-standard benchmarks (Cinebench, Geekbench, 3DMark, UL Procyon) with standardized real-world stress tests.
        </p>
        <p>
          Whether evaluating the battery drain of a Snapdragon X Elite laptop or measuring thermal throttling during a 4-hour local LLM generation run, our goal is to deliver actionable data so you spend your money wisely.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
