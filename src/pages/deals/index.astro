---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AffButton from "../../components/AffButton.astro";
import RatingBadge from "../../components/RatingBadge.astro";
import { getCollection } from "astro:content";
import { formatCategory, formatPrice } from "../../utils/format";
import { Tag, Info } from "@lucide/astro";

const allReviews = await getCollection("reviews");
const dealReviews = allReviews
  .filter((r) => r.data.price !== undefined || r.data.amazonUrl)
  .sort((a, b) => b.data.rating - a.data.rating);

const canonical = "https://geektechreview.com/deals/";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Deals", href: canonical },
];
---

<BaseLayout
  title="Best Tech Deals & Hardware Discounts (2026)"
  description="Live tracking of lab-tested tech hardware deals, Amazon discounts, and price drops."
  canonical={canonical}
>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <!-- Top Affiliate Disclosure Banner -->
    <div class="mb-8 flex items-start gap-3 rounded-2xl border border-[var(--color-primary)]/30 bg-[var(--color-primary)]/10 p-4 text-xs text-[var(--color-text)]">
      <Info class="h-5 w-5 shrink-0 text-[var(--color-primary)]" />
      <div>
        <strong class="font-semibold text-[var(--color-primary)]">Affiliate Disclosure:</strong> When you buy through links on GeekTechReview, we may earn an affiliate commission at no extra cost to you. Prices and availability are checked regularly and are subject to change.
      </div>
    </div>

    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full bg-[var(--color-success)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-success)]">
        <Tag class="h-3.5 w-3.5" />
        <span>Price Drops & Offers</span>
      </div>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        Best Tech Deals
      </h1>
      <p class="mt-2 max-w-2xl text-lg text-[var(--color-muted)]">
        Curated discounts on top-rated hardware tested and verified by our editorial lab.
      </p>
    <section>
      <h2 class="sr-only">Live Hardware Deals</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {dealReviews.map((r) => {
        const href = `/reviews/${r.data.category}/${r.data.slug || r.id}/`;
        const priceStr = formatPrice(r.data.price, r.data.priceCurrency);
        return (
          <article class="flex flex-col justify-between overflow-hidden card-surface border border-[var(--color-border)] p-6 transition hover:border-[var(--color-primary)]/50">
            <div>
              <div class="flex items-center justify-between">
                <span class="rounded-full bg-[var(--color-surface-2)] px-2.5 py-1 text-[11px] font-semibold text-[var(--color-muted)]">
                  {formatCategory(r.data.category)}
                </span>
                <RatingBadge score={r.data.rating} size="sm" />
              </div>

              <h3 class="mt-3 font-display text-xl font-bold leading-snug">
                <a href={href} class="hover:text-[var(--color-primary)]">{r.data.title}</a>
              </h3>

              <p class="mt-2 line-clamp-2 text-sm text-[var(--color-muted)]">
                {r.data.description}
              </p>
            </div>

            <div class="mt-6 border-t border-[var(--color-border)] pt-4">
              <div class="mb-3 flex items-center justify-between">
                <div>
                  <span class="text-xs text-[var(--color-muted)]">Current Price</span>
                  <div class="text-lg font-extrabold tabular-nums text-[var(--color-text)]">
                    {priceStr ?? "Check Amazon"}
                  </div>
                </div>
                <a href={href} class="text-xs font-semibold text-[var(--color-primary)] hover:underline">
                  Read Review →
                </a>
              </div>

              <AffButton
                amazonUrl={r.data.amazonUrl}
                price={r.data.price}
                priceCurrency={r.data.priceCurrency}
                label="View Deal on Amazon"
                variant="primary"
                size="md"
              />
            </div>
          </article>
        );
      })}
    </div>
    </section>
  </div>
</BaseLayout>
