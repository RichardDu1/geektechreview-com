---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { BookOpen, Clock, ArrowRight } from "@lucide/astro";

const canonical = "https://geektechreview.com/guides/";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Guides", href: canonical },
];

const upcomingGuides = [
  {
    title: "How to Choose an AI PC in 2026: TOPS, NPUs & Memory Requirements",
    category: "Laptops",
    description: "Everything you need to know about Copilot+ specifications, Intel Lunar Lake, AMD Strix Point, and Qualcomm Snapdragon X Elite.",
  },
  {
    title: "The Ultimate Guide to Local LLM Hardware: VRAM, RAM Speed & GPU Selection",
    category: "AI Devices",
    description: "How to configure a workstation for running Llama 3, DeepSeek, and Mistral models locally without cloud latency.",
  },
  {
    title: "OLED vs QD-OLED vs Mini-LED: Which Gaming Monitor Engine Should You Buy?",
    category: "Gaming",
    description: "Lab breakdown of burn-in risks, peak brightness nits, subpixel layouts, and response times for competitive gaming.",
  },
  {
    title: "Matter & Thread Protocol Setup Guide for Smart Homes",
    category: "Smart Home",
    description: "Step-by-step guide to configuring border routers, multi-admin controllers, and cross-platform automation.",
  },
];
---

<BaseLayout
  title="Hardware Buying Guides & Tech Manuals (2026)"
  description="In-depth, technical buying guides and hardware selection manuals written by lab engineers."
  canonical={canonical}
>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full bg-[var(--color-accent)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-accent)]">
        <BookOpen class="h-3.5 w-3.5" />
        <span>Hardware Manuals</span>
      </div>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        Buying Guides
      </h1>
      <p class="mt-2 max-w-2xl text-lg text-[var(--color-muted)]">
        Comprehensive guides to help you make informed technical decisions before purchasing.
      </p>
    </header>

    <div class="grid gap-6 sm:grid-cols-2">
      {upcomingGuides.map((g) => (
        <article class="flex flex-col justify-between card-surface border border-[var(--color-border)] p-6 sm:p-8">
          <div>
            <div class="flex items-center justify-between">
              <span class="rounded-full bg-[var(--color-surface-2)] px-2.5 py-1 text-[11px] font-semibold text-[var(--color-muted)]">
                {g.category}
              </span>
              <span class="inline-flex items-center gap-1 text-xs text-[var(--color-warning)] font-medium">
                <Clock class="h-3.5 w-3.5" /> Coming Soon
              </span>
            </div>

            <h2 class="mt-4 font-display text-xl font-bold leading-snug">
              {g.title}
            </h2>

            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">
              {g.description}
            </p>
          </div>

          <div class="mt-6 border-t border-[var(--color-border)] pt-4 flex items-center justify-between text-xs text-[var(--color-muted)]">
            <span>Engineering Spec Manual</span>
            <a href="/reviews/" class="inline-flex items-center gap-1 font-semibold text-[var(--color-primary)] hover:underline">
              Explore Reviews <ArrowRight class="h-3.5 w-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
