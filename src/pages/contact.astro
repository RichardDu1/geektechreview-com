---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { Mail, MessageSquare, Send } from "@lucide/astro";

const canonical = "https://geektechreview.com/contact/";

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Contact Us", href: canonical },
];
---

<BaseLayout
  title="Contact Us — GeekTechReview Editorial Team"
  description="Get in touch with the GeekTechReview lab team for hardware review requests, technical inquiries, or general feedback."
  canonical={canonical}
>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <header class="mb-12 max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]/10 px-3.5 py-1.5 text-xs font-semibold text-[var(--color-primary)]">
        <Mail class="h-4 w-4" />
        <span>Get in Touch</span>
      </div>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        Contact Us
      </h1>
      <p class="mt-4 text-xl text-[var(--color-muted)] leading-relaxed">
        Have a hardware question, benchmark suggestion, or correction for our editorial team? We'd love to hear from you.
      </p>
    </header>

    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <form class="card-surface border border-[var(--color-border)] space-y-6 p-8" onsubmit="event.preventDefault(); alert('Thank you! Your message has been recorded.');">
          <div>
            <label for="name" class="block text-sm font-semibold text-[var(--color-text)]">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Alex Chen"
              class="mt-2 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] placeholder-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-[var(--color-text)]">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="alex@example.com"
              class="mt-2 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] placeholder-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none"
            />
          </div>

          <div>
            <label for="subject" class="block text-sm font-semibold text-[var(--color-text)]">
              Subject
            </label>
            <select
              id="subject"
              name="subject"
              class="mt-2 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] focus:border-[var(--color-primary)] focus:outline-none"
            >
              <option value="general">General Inquiry</option>
              <option value="review-request">Hardware Review Request</option>
              <option value="correction">Benchmark / Data Correction</option>
              <option value="press">Press & Media</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-[var(--color-text)]">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell us how we can help..."
              class="mt-2 w-full rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] px-4 py-3 text-sm text-[var(--color-text)] placeholder-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-primary)] px-6 py-3.5 text-sm font-bold text-white transition hover:opacity-90 sm:w-auto"
          >
            <Send class="h-4 w-4" />
            <span>Send Message</span>
          </button>
        </form>
      </div>

      <!-- Info Sidebar -->
      <aside class="space-y-6 lg:col-span-5">
        <div class="card-surface p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <MessageSquare class="h-6 w-6 text-[var(--color-primary)]" />
            <h2 class="font-display text-xl font-bold">Editorial Office</h2>
          </div>
          <div class="mt-4 space-y-4 text-sm text-[var(--color-muted)]">
            <div>
              <strong class="block font-semibold text-[var(--color-text)]">Location</strong>
              <span>GeekTechReview Hardware Testing Lab<br />San Francisco, CA, USA</span>
            </div>
            <div>
              <strong class="block font-semibold text-[var(--color-text)]">Direct Email</strong>
              <a href="mailto:contact@geektechreview.com" class="text-[var(--color-primary)] hover:underline">contact@geektechreview.com</a>
            </div>
            <div>
              <strong class="block font-semibold text-[var(--color-text)]">Response Time</strong>
              <span>We aim to respond to technical inquiries within 1-2 business days.</span>
            </div>
          </div>
        </div>

        <div class="card-surface p-6">
          <h3 class="font-display text-base font-bold">Looking for something specific?</h3>
          <ul class="mt-3 space-y-2 text-xs text-[var(--color-primary)]">
            <li><a href="/how-we-test/" class="hover:underline">Read our Testing Methodology →</a></li>
            <li><a href="/editorial-policy/" class="hover:underline">Review our Editorial Policy →</a></li>
            <li><a href="/affiliate-disclosure/" class="hover:underline">View Affiliate Disclosure →</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
