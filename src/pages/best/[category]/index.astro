---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { formatCategory, CATEGORY_SLUGS } from "../../../utils/format";
import { generateListSchema } from "../../../utils/schema";
import { getCollection } from "astro:content";
import { Clock } from "@lucide/astro";

export async function getStaticPaths() {
  return CATEGORY_SLUGS.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const categoryLabel = formatCategory(category);
const canonical = `https://geektechreview.com/best/${category}/`;

const allReviews = await getCollection("reviews");
const categoryReviews = allReviews
  .filter((r) => r.data.category === category)
  .sort((a, b) => b.data.rating - a.data.rating);

const schemaItems = categoryReviews.map((r) => ({
  name: r.data.title,
  url: `https://geektechreview.com/reviews/${category}/${r.data.slug || r.id}/`,
  rating: r.data.rating,
}));

const faqs = [
  {
    question: `What are the best ${categoryLabel.toLowerCase()} in 2026?`,
    answer: `Our upcoming best ${categoryLabel.toLowerCase()} guide for 2026 ranks every model we've lab-tested by overall rating, value, and feature set. In the meantime, browse our individual ${categoryLabel.toLowerCase()} reviews for detailed benchmark scores and verdicts.`,
  },
  {
    question: `How does GeekTechReview rank ${categoryLabel.toLowerCase()}?`,
    answer: `Each product is scored on a standardized 0-10 scale across performance, value, design, features, and (where relevant) battery efficiency, using our published Methodology v1.0 testing protocols. Products are then ordered by total weighted score.`,
  },
];

const schema = generateListSchema(schemaItems, `Best ${categoryLabel} of 2026`, faqs);

const crumbs = [
  { name: "Home", href: "/" },
  { name: "Best Of", href: "/best/laptops/" },
  { name: categoryLabel, href: canonical },
];
---

<BaseLayout
  title={`Best ${categoryLabel} (2026) — Rankings & Buying Advice`}
  description={`Lab-backed roundup of the best ${categoryLabel.toLowerCase()} tested by GeekTechReview.`}
  canonical={canonical}
  schema={schema}
>
  <div class="container-page py-6">
    <Breadcrumb items={crumbs} />

    <header class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-primary)]">
        <span>Curated Buyer's Guide</span>
      </div>
      <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
        Best {categoryLabel} of 2026
      </h1>
      <p class="mt-2 max-w-2xl text-lg text-[var(--color-muted)]">
        Our upcoming definitive guide to the top-performing {categoryLabel.toLowerCase()} across all price points.
      </p>
    </header>

    <div class="card-surface flex flex-col items-center justify-center p-12 text-center">
      <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-surface-2)] text-[var(--color-muted)]">
        <Clock class="h-8 w-8" />
      </div>
      <h2 class="mt-6 font-display text-2xl font-bold">Best {categoryLabel} Guide Coming Soon</h2>
      <p class="mt-2 max-w-md text-sm text-[var(--color-muted)]">
        We are currently expanding our test dataset and benchmark results for {categoryLabel.toLowerCase()}. Check out our latest individual reviews in the meantime!
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={`/reviews/${category}/`}
          class="rounded-xl bg-[var(--color-primary)] px-6 py-3 text-sm font-bold text-white transition hover:opacity-90"
        >
          View All {categoryLabel} Reviews
        </a>
        <a
          href="/reviews/"
          class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-2)] px-6 py-3 text-sm font-bold text-[var(--color-text)] transition hover:border-[var(--color-muted)]"
        >
          Browse All Categories
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
