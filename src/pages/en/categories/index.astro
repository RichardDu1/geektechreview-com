---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Card from '../../../components/Card.astro';

const title = 'Tech Review Categories — Geek Tech Review (2026)';
const description = 'Browse in-depth reviews by category: laptops, phones, audio, gaming, and smart home devices.';
---

<BaseLayout title={title} description={description}>
  <Breadcrumb />
  <section class="container py-16">
    <h1 class="text-3xl font-bold mb-8 text-center">Tech Review Categories</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <Card title="Laptops" description="Ultrabooks, gaming laptops, workstations, and Chromebooks — tested and ranked" href="/en/categories/laptops/" />
      <Card title="Phones" description="Flagship smartphones, budget picks, foldables, and accessories" href="/en/categories/phones/" />
      <Card title="Audio" description="Headphones, earbuds, speakers, and soundbars — sound quality tested" href="/en/categories/audio/" />
      <Card title="Gaming" description="Consoles, GPUs, monitors, keyboards, and gaming peripherals" href="/en/categories/gaming/" />
      <Card title="Smart Home" description="Smart locks, lights, cameras, and hubs — tested for real homes" href="/en/categories/smart-home/" />
      <Card title="DevTools" description="Mechanical keyboards, monitors, desks, and gear for developers" href="/en/categories/devtools/" />
    </div>
  </section>
</BaseLayout>
