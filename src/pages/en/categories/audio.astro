---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const reviews = (await getCollection('reviews')).filter(r => r.data.category?.toLowerCase().includes('audio') || r.data.category?.toLowerCase().includes('headphone') || r.data.category?.toLowerCase().includes('speaker'));
const title = 'Best Audio Gear Reviews (2026) — Geek Tech Review';
const description = 'In-depth reviews of headphones, earbuds, speakers, and soundbars.';
---
<BaseLayout title={title} description={description}>
  <Breadcrumb />
  <section class="container py-16">
    <h1 class="text-3xl font-bold mb-8">Audio Gear Reviews</h1>
    <p class="text-muted mb-8">Headphones, earbuds, speakers, and soundbars — tested for sound quality, comfort, and value.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map(review => (
        <a href={`/en/reviews/${review.slug}/`} class="block p-6 rounded-xl border border-border hover:border-primary-500 transition-colors">
          <h2 class="text-xl font-bold mb-2">{review.data.title}</h2>
          <p class="text-muted text-sm">{review.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
